{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "film.schema.json",
  "title": "Film",
  "description": "বাংলা চলচ্চিত্র। Film এর ভেতরে গান, পরিচালক, অভিনেতা ইত্যাদি সম্পর্কিত।",
  "type": "object",
  "required": ["id", "title_bn", "type", "verification_status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FILM\\d{6}$",
      "description": "Display identifier: FILM000001"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "title_bn": {
      "type": "string",
      "description": "বাংলায় শিরোনাম"
    },
    "title_en": {
      "type": ["string", "null"]
    },
    "type": {
      "type": "string",
      "enum": ["feature_film", "short_film", "documentary", "telefilm", "other"],
      "description": "চলচ্চিত্রের ধরন"
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1800,
      "maximum": 2100
    },
    "year_accuracy": {
      "type": ["string", "null"],
      "enum": ["exact", "approximate", "estimated", null]
    },
    "country": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    },
    "language": {
      "type": "string",
      "description": "ভাষা কোড"
    },
    "director_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ART\\d{6}$" },
      "description": "পরিচালকদের ART ID"
    },
    "producer_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ART\\d{6}$" },
      "description": "প্রযোজকদের ART ID"
    },
    "actor_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ART\\d{6}$" },
      "description": "অভিনেতাদের ART ID"
    },
    "music_director_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ART\\d{6}$" },
      "description": "সঙ্গীত পরিচালকদের ART ID"
    },
    "lyricist_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ART\\d{6}$" },
      "description": "গীতিকারদের ART ID"
    },
    "studio_id": {
      "type": ["string", "null"],
      "pattern": "^LAB\\d{6}$",
      "description": "Production studio (label)"
    },
    "synopsis": {
      "type": ["string", "null"]
    },
    "work_ids": {
      "type": "array",
      "description": "এই film এ ব্যবহৃত গান/Works",
      "items": { "type": "string", "pattern": "^WORK\\d{6}$" }
    },
    "recording_ids": {
      "type": "array",
      "description": "এই film এ ব্যবহৃত recordings",
      "items": { "type": "string", "pattern": "^REC\\d{6}$" }
    },
    "source_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC\\d{6}$" },
      "uniqueItems": true
    },
    "verification_status": {
      "type": "string",
      "enum": ["pending", "in_review", "verified", "rejected"]
    },
    "data_origin": {
      "type": "string",
      "enum": ["human", "ai_suggestion", "musicbrainz", "wikidata", "manual"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "editor", "action"],
        "properties": {
          "date": { "type": "string", "format": "date-time" },
          "editor": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
